rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'maniyajitesh56@gmail.com';
    }

    function workerExists(uid) {
      return exists(/databases/$(database)/documents/workers/$(uid));
    }

    function isWorkerBoss(uid) {
      return signedIn()
        && workerExists(uid)
        && get(/databases/$(database)/documents/workers/$(uid)).data.bossUid == request.auth.uid
        && get(/databases/$(database)/documents/workers/$(uid)).data.removed != true;
    }

    function companyCodeExists(code) {
      return exists(/databases/$(database)/documents/companyCodes/$(code));
    }

    function companyCodeData(code) {
      return get(/databases/$(database)/documents/companyCodes/$(code)).data;
    }

    function isCodeBoss(code) {
      return signedIn()
        && companyCodeExists(code)
        && companyCodeData(code).bossUid == request.auth.uid;
    }

    function isCodeMember(code, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/companyCodes/$(code)/members/$(uid))
        && get(/databases/$(database)/documents/companyCodes/$(code)/members/$(uid)).data.removed != true;
    }

    function isCompanyBoss(companyId) {
      return signedIn() && request.auth.uid == companyId;
    }

    function isCompanyMember(companyId, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(uid)).data.removed != true;
    }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow read, update: if isWorkerBoss(uid);
      allow read, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow create, update, delete: if isCompanyBoss(companyId);
      allow read: if isCompanyBoss(companyId)
        || isCompanyMember(companyId, request.auth.uid)
        || isSuperAdmin();
      allow update: if isSuperAdmin();

      match /members/{uid} {
        allow create, update: if signedIn() && (
          request.auth.uid == uid
          || request.auth.uid == companyId
          || isSuperAdmin()
        );

        allow read: if signedIn() && (
          request.auth.uid == uid
          || request.auth.uid == companyId
          || isSuperAdmin()
        );

        allow delete: if isCompanyBoss(companyId) || isSuperAdmin();
      }

      match /notices/{noticeId} {
        allow create, update, delete: if isCompanyBoss(companyId) || isSuperAdmin();

        allow read: if signedIn() && (
          isCompanyBoss(companyId)
          || isCompanyMember(companyId, request.auth.uid)
          || isSuperAdmin()
        );
      }
    }

    match /companyCodes/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.bossUid == request.auth.uid
        && request.resource.data.companyId == request.auth.uid;

      allow update, delete: if isCodeBoss(code) || isSuperAdmin();

      match /members/{uid} {
        allow create, update: if signedIn()
          && companyCodeExists(code)
          && (
            request.auth.uid == uid
            || isCodeBoss(code)
            || isSuperAdmin()
          )
          && request.resource.data.companyCode == code
          && request.resource.data.companyId == companyCodeData(code).companyId;

        allow read: if signedIn() && (
          request.auth.uid == uid
          || isCodeBoss(code)
          || isSuperAdmin()
        );

        allow delete: if isCodeBoss(code) || isSuperAdmin();
      }

      match /notices/{noticeId} {
        allow create, update, delete: if isCodeBoss(code) || isSuperAdmin();

        allow read: if signedIn() && (
          isCodeBoss(code)
          || isCodeMember(code, request.auth.uid)
          || isSuperAdmin()
        );
      }
    }

    match /workers/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;

      allow create, update: if signedIn()
        && request.resource.data.bossUid == request.auth.uid;

      allow read, update: if signedIn()
        && resource.data.bossUid == request.auth.uid;

      allow read, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /notifications/{noticeId} {
      allow create: if signedIn() && (
        (
          request.resource.data.companyId == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
        )
        || isSuperAdmin()
      );

      allow read: if signedIn() && (
        resource.data.companyId == request.auth.uid
        || isCompanyMember(resource.data.companyId, request.auth.uid)
        || isSuperAdmin()
      );

      allow update, delete: if signedIn() && (
        resource.data.companyId == request.auth.uid
        || isSuperAdmin()
      );
    }

    match /diaryEntries/{uid}/items/{itemId} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid;

      allow read: if signedIn() && (
        request.auth.uid == uid
        || isWorkerBoss(uid)
        || isSuperAdmin()
      );
    }

    match /userSettings/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }
  }
}
