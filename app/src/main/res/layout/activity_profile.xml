<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp"
    android:background="@color/navy">
    <ImageView android:id="@+id/profile_photo" android:layout_width="112dp" android:layout_height="112dp"
        android:src="@drawable/apno_mark" android:scaleType="centerCrop" android:contentDescription="Profile photo" />
    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="Your name" android:textSize="26sp"
        android:textStyle="bold" android:textColor="@color/white" />
    <TextView android:id="@+id/preview_id" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Local preview ID" android:textColor="@color/muted" />
    <Button android:id="@+id/edit_name" android:layout_width="match_parent" android:layout_height="55dp"
        android:layout_marginTop="35dp" android:text="Edit name" android:textAllCaps="false" />
    <Button android:id="@+id/choose_photo" android:layout_width="match_parent" android:layout_height="55dp"
        android:layout_marginTop="10dp" android:text="Choose photo from gallery" android:textAllCaps="false" />
    <Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="55dp"
        android:layout_marginTop="10dp" android:text="Back to rooms" android:textAllCaps="false" />
</LinearLayout>
