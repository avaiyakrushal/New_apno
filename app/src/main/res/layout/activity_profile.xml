<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My profile"
            android:textSize="30sp" android:textStyle="bold" android:textColor="@color/ink" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="30dp">
            <ImageView android:id="@+id/profile_photo" android:layout_width="112dp" android:layout_height="112dp"
                android:src="@drawable/apno_mark" android:scaleType="centerCrop" android:contentDescription="Profile photo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingLeft="18dp">
                <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Your name" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/ink" />
                <TextView android:id="@+id/preview_id" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Local preview ID" android:textColor="@color/subtle" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/bio" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Add a short bio" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:id="@+id/post_count" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="0 local posts" android:textColor="@color/subtle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp"
            android:text="Profile settings" android:textColor="@color/ink" android:textStyle="bold" android:textSize="22sp" />
        <Button android:id="@+id/edit_name" android:layout_width="match_parent" android:layout_height="55dp"
            android:layout_marginTop="18dp" android:text="Edit name" android:textAllCaps="false" />
        <Button android:id="@+id/choose_photo" android:layout_width="match_parent" android:layout_height="55dp"
            android:layout_marginTop="10dp" android:text="Choose profile photo" android:textAllCaps="false" />
        <Button android:id="@+id/edit_bio" android:layout_width="match_parent" android:layout_height="55dp"
            android:layout_marginTop="10dp" android:text="Edit bio" android:textAllCaps="false" />
        <Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="55dp"
            android:layout_marginTop="10dp" android:text="Back to Apno" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
