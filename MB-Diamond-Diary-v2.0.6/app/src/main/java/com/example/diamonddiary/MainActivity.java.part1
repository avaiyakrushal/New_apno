public class MainActivity extends Activity {
    private WebView page;
    private WebView printing;
    private ValueCallback<Uri[]> chooserCallback;
    private static final int FILE_CHOOSE = 93;

    private FirebaseAuth auth;
    private FirebaseFirestore database;
    private CredentialManager credentials;

    private LinearLayout login;
    private Button loginButton;
    private TextView loginStatus;

    private LinearLayout roleChoice;
    private LinearLayout workerProfile;
    private EditText profileFirstName;
    private EditText profileLastName;
    private EditText profilePhone;
    private EditText profileBirthday;
    private Button workerProfileSave;

    private LinearLayout bossScreen;
    private LinearLayout bossCreateBox;
    private LinearLayout bossInfoBox;
    private EditText bossCompanyInput;
    private TextView bossCompanyName;
    private TextView bossCompanyCode;
    private TextView bossWorkersTitle;
